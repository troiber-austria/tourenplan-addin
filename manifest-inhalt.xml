<?xml version="1.0" encoding="UTF-8"?>
<!-- Optional: Variante als "Inhalts-Add-in" - die Karte sitzt dann fest an einer Stelle im Tabellenblatt
     (Einfügen > Add-Ins), statt im Aufgabenbereich. Funktioniert mit derselben Seite. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>b2f7d9c4-15a8-4e63-8c0b-7a9e4d2f6c31</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Pier Seven Foods</ProviderName>
  <DefaultLocale>de-AT</DefaultLocale>
  <DisplayName DefaultValue="Tourenplan-Karte (im Blatt)"/>
  <Description DefaultValue="Karte mit LKW-Route und Live-Fahrzeit, fest im Tabellenblatt verankert."/>
  <IconUrl DefaultValue="https://troiber-austria.github.io/tourenplan-addin/icons/icon-32.png"/>
  <SupportUrl DefaultValue="https://troiber-austria.github.io/tourenplan-addin/index.html"/>
  <AppDomains>
    <AppDomain>https://api.openrouteservice.org</AppDomain>
    <AppDomain>https://routes.googleapis.com</AppDomain>
    <AppDomain>https://maps.googleapis.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://troiber-austria.github.io/tourenplan-addin/index.html"/>
    <RequestedWidth>760</RequestedWidth>
    <RequestedHeight>520</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
